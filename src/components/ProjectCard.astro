---
import { copy, url, type Locale, type ProjectId, projects } from '../content';
interface Props { locale:Locale; project: typeof projects[number] }
const {locale,project} = Astro.props;
const item = copy[locale].projects[project.id as ProjectId];
const t = copy[locale];
---
<article class="project" data-category={project.category}>
  <a class="project-image" href={url(locale,'projects/'+project.id)} aria-label={project.name+' '+t.details}>
    <img src={project.image} alt={item.alt} loading="lazy" decoding="async" />
  </a>
  <div class="project-body">
    <div><p class="tag">{item.type}</p><h3><a href={url(locale,'projects/'+project.id)}>{project.name}</a></h3><p>{item.summary}</p></div>
    <div class="actions"><a class="button secondary" href={url(locale,'projects/'+project.id)}>{t.details}</a><a class="text-link" href={project.repo}>GitHub</a></div>
  </div>
</article>
