---
interface Props {
  id: string;
  color: string;
}

const { id, color } = Astro.props;
---

<span class="agent-character" style={`--agent-accent:${color}`} aria-hidden="true">
  <img src={`/assets/agents/${id}.svg`} width="256" height="256" alt="" loading="lazy" />
  <svg class="agent-wave-arm" viewBox="0 0 56 74" fill="none" aria-hidden="true" width="56" height="74">
    <path d="M15 67c8-5 14-12 17-23l3-12" stroke="currentColor" stroke-width="7" stroke-linecap="round" />
    <path d="M27 43c-6-6-11-10-11-14 0-4 4-5 7-2l5 5V13a3.5 3.5 0 0 1 7 0v11h2V9a3.5 3.5 0 0 1 7 0v15h2V14a3.5 3.5 0 0 1 7 0v18c0 11-5 18-14 18-5 0-9-2-12-7Z" fill="#252e3d" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="15" cy="67" r="4" fill="#252e3d" stroke="currentColor" stroke-width="3" />
  </svg>
</span>
