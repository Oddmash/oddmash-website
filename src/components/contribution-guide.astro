---
import { copy, type Locale } from '../content';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
const guide = {
  en: [
    ['Choose an issue', 'Search existing issues before opening a new one. Choose the Bug, Feature, Fix, Documentation or Test template that matches your work. Explain the problem, reproduction or proposal, and measurable acceptance criteria.'],
    ['Prepare a focused change', 'Read the repository CONTRIBUTING.md and AGENTS.md. Fork if needed and create a topic branch from its integration branch. Product repositories generally use develop; main-only repositories including this website target main.'],
    ['Open a pull request', 'Use the repository PR template. Describe the change, actual verification, compatibility and risks. Include Refs #123 for partial or integration work and Closes #123 only when the default-branch merge completes the issue.'],
    ['Pass required checks', 'The required aggregate verify check must pass for the current revision. This website also runs contribution metadata checks, type checks, build, static tests and browser tests on Chromium, Firefox and WebKit. Other repositories declare their own checks. Fork workflows may await maintainer approval.'],
    ['Respond to review', 'Request formal review with /review on its own line if needed. Fix findings or explain non-adoption in the original thread, record verification and resolve addressed threads. New commits require fresh checks. Maintainers merge using the repository policy.'],
  ],
  ko: [
    ['이슈 선택 및 등록', '기존 이슈를 먼저 검색하세요. 새 이슈는 Bug, Feature, Fix, Documentation, Test 등 목적에 맞는 영문 템플릿을 선택합니다. 문제, 재현 방법 또는 제안, 측정 가능한 완료 조건을 작성하세요.'],
    ['작업 브랜치 생성', '저장소의 CONTRIBUTING.md와 AGENTS.md를 확인하세요. 필요하면 Fork한 뒤 통합 브랜치에서 작업 브랜치를 만듭니다. 일반 제품은 develop, 이 웹사이트처럼 main-only인 저장소는 main을 기준으로 작업합니다.'],
    ['PR 작성 및 이슈 연결', '저장소의 PR 템플릿에 변경 범위, 실제 검증 결과, 호환성, 위험 요소를 작성합니다. 통합 브랜치 또는 부분 작업은 Refs #123, 기본 브랜치 병합으로 완료되는 이슈는 Closes #123으로 연결하세요.'],
    ['필수 CI 통과', '현재 커밋의 필수 통합 검사 verify가 통과해야 합니다. 이 웹사이트는 기여 메타데이터, 타입 검사, 빌드, 정적 테스트 및 Chromium, Firefox, WebKit 브라우저 테스트를 실행합니다. 프로젝트별 검사는 다를 수 있으며 외부 Fork의 워크플로는 관리자의 실행 승인이 필요할 수 있습니다.'],
    ['리뷰 반영 및 병합', '필요하면 PR 댓글의 첫 줄에 /review를 작성하세요. 지적 사항을 수정하거나 반영하지 않는 이유를 원래 스레드에 남기고 검증 결과를 기록한 뒤 해당 스레드를 해결 처리하세요. 새 커밋은 다시 검증하며 관리자가 저장소 규칙에 따라 병합합니다.'],
  ],
  ja: [
    ['Issue を選ぶ', '既存 Issue を検索し、Bug、Feature、Fix、Documentation、Test など目的に合った英語テンプレートで課題と完了条件を記述します。'],
    ['変更を準備する', 'CONTRIBUTING.md と AGENTS.md を読み、通常は develop、main-only のリポジトリでは main から作業ブランチを作成します。'],
    ['PR を作成する', 'PR テンプレートに変更、検証、互換性、リスクを記述します。部分的な変更には Refs #123、既定ブランチで完了する場合は Closes #123 を使用します。'],
    ['必須 CI を通過する', '現在の変更で集約チェック verify が成功する必要があります。このサイトではメタデータ、型、ビルド、静的テストと三つのブラウザーを検証します。Fork の実行には承認が必要な場合があります。'],
    ['レビューに対応する', '必要なら /review を単独行で投稿します。修正または不採用理由を元のスレッドに記録し、検証して解決します。新しいコミットは再検証します。'],
  ],
  'zh-CN': [
    ['选择议题', '先搜索已有议题，按目的选择 Bug、Feature、Fix、Documentation 或 Test 英文模板，说明问题和可衡量的验收标准。'],
    ['准备修改', '阅读 CONTRIBUTING.md 和 AGENTS.md。一般产品从 develop 建立分支，仅使用 main 的仓库则以 main 为基础。'],
    ['提交 PR', '填写 PR 模板，说明变更、验证、兼容性和风险。部分工作使用 Refs #123；默认分支合并后完成议题时使用 Closes #123。'],
    ['通过必需 CI', '当前提交必须通过汇总检查 verify。本网站检查元数据、类型、构建、静态测试及三个浏览器。Fork 工作流可能需要维护者批准。'],
    ['处理审查', '需要时单独一行发送 /review。修复问题或在原线程记录不采纳原因及验证结果，再解决线程。新提交需要重新验证。'],
  ],
}[locale];
---
<article class="contribution-guide">
  <header class="detail-head"><p class="eyebrow">Oddmash</p><h1>{t.guide}</h1><p class="lead">{t.contributeText}</p></header>
  <ol aria-label={t.guide}>
    {guide.map(([title, body], index) => <li><h2>{index + 1}. {title}</h2><p>{body}</p></li>)}
  </ol>
  <div class="actions">
    <a class="button primary" href="https://github.com/search?q=org%3AOddmash+is%3Aissue+is%3Aopen&type=issues">{t.contribute}</a>
    <a class="button secondary" href="https://github.com/Oddmash/.github/tree/main/.github/ISSUE_TEMPLATE">Issue templates</a>
    <a class="button secondary" href="https://github.com/Oddmash/.github/blob/main/AGENTS.md">AGENTS.md</a>
  </div>
</article>
