---
import type { Locale } from '../content';
import { ecosystemCopy } from '../ecosystem-content';
import { labCopy } from '../lab-content';
import AgentRoster from './agent-roster.astro';
import WorkflowPlayer from './workflow-player.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = labCopy[locale];
const ecosystem = ecosystemCopy[locale];
---
<section class="section lab-method" id="method" aria-labelledby="method-title">
  <div class="section-title">
    <h2 id="method-title">{c.methodTitle}</h2>
    <p>{c.methodLead}</p>
  </div>
  <ol class="method-list" role="list">
    {c.methods.map((method, index) => <li class="method-item">
      <span class="method-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <h3>{method.title}</h3>
      <p>{method.body}</p>
    </li>)}
  </ol>
  <a class="text-link ecosystem-method-link" href="https://github.com/Oddmash/oddmash-skills">{ecosystem.skillsLink}</a>
</section>
<AgentRoster locale={locale} compact={true} />
<WorkflowPlayer locale={locale} />
