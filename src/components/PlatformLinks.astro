---
import { PlatformLink } from '@oddmash/ui/platform-link';
import { createElement } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';
interface Props {
  name: string;
  github: string;
  npm?: string | null;
  homepage?: string | null;
  homepageLabel?: string;
  docs?: string;
  docsLabel?: string;
  docsPrimary?: boolean;
}
const { name, github, npm, homepage, homepageLabel = 'Homepage', docs, docsLabel = 'Documentation', docsPrimary = false } = Astro.props;
const githubLabel = name + ' · GitHub';
const npmLabel = name + ' · npm';
const renderPlatform = (platform: 'github' | 'npm', href: string, label: string) =>
  renderToStaticMarkup(createElement(PlatformLink, { platform, href, 'aria-label': label, title: label, className: 'platform-link' }));
---
<div class:list={['platform-links', 'om-platform-links', {'platform-links-labeled': docsPrimary}]}>
  <Fragment set:html={renderPlatform('github', github, githubLabel)} />
  {npm && <Fragment set:html={renderPlatform('npm', 'https://www.npmjs.com/package/'+npm, npmLabel)} />}
  {homepage && <a class="platform-link om-platform-link" data-platform="homepage" href={homepage} aria-label={name+' · '+homepageLabel} title={name+' · '+homepageLabel}>
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="9.25" />
      <path d="M2.75 12h18.5M12 2.75c3 2.8 4.3 5.88 4.3 9.25S15 18.45 12 21.25M12 2.75C9 5.55 7.7 8.63 7.7 12S9 18.45 12 21.25" />
    </svg>
  </a>}
  {docs && <a class:list={['platform-link', 'om-platform-link', {'project-destination': docsPrimary}]} data-platform="docs" href={docs} aria-label={name+' · '+docsLabel} title={name+' · '+docsLabel}>
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 3.5h9.5l4.5 4.75v12.25H5zM14.5 3.5v4.75H19M8.5 12h7M8.5 15.5h7" />
    </svg>
    <span>{docsLabel}</span>
  </a>}
</div>
