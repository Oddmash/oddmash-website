---
interface Props {
  name: string;
  github: string;
  npm?: string | null;
  homepage?: string | null;
  homepageLabel?: string;
  docs?: string;
  docsLabel?: string;
  docsPrimary?: boolean;
}
const { name, github, npm, homepage, homepageLabel = 'Homepage', docs, docsLabel = 'Documentation', docsPrimary = false } = Astro.props;
const githubLabel = name + ' · GitHub';
const npmLabel = name + ' · npm';
---
<div class:list={['platform-links', {'platform-links-labeled': docsPrimary}]}>
  <a class="platform-link" data-platform="github" href={github} aria-label={githubLabel} title={githubLabel}>
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false" fill="currentColor">
      <path d="M12 1.3a10.7 10.7 0 0 0-3.38 20.85c.54.1.73-.23.73-.52V19.6c-2.98.65-3.61-1.27-3.61-1.27-.49-1.23-1.19-1.56-1.19-1.56-.97-.67.08-.66.08-.66 1.08.08 1.65 1.11 1.65 1.11.95 1.64 2.49 1.16 3.1.89.1-.69.37-1.16.67-1.43-2.38-.27-4.88-1.19-4.88-5.29 0-1.17.42-2.13 1.1-2.88-.11-.27-.48-1.36.11-2.84 0 0 .9-.29 2.94 1.1a10.2 10.2 0 0 1 5.36 0c2.04-1.39 2.93-1.1 2.93-1.1.59 1.48.22 2.57.11 2.84.68.75 1.1 1.71 1.1 2.88 0 4.11-2.51 5.01-4.9 5.28.39.34.73 1 .73 2.01v2.95c0 .29.19.63.74.52A10.7 10.7 0 0 0 12 1.3Z"/>
    </svg>
    {docsPrimary && <span>GitHub</span>}
  </a>
  {npm && <a class="platform-link" data-platform="npm" href={'https://www.npmjs.com/package/'+npm} aria-label={npmLabel} title={npmLabel}>
    <svg viewBox="0 0 32 12" width="32" height="12" aria-hidden="true" focusable="false" fill="currentColor">
      <path fill-rule="evenodd" d="M0 0H32V12H0ZM2 2V10H4V4H6V10H8V2ZM10 2V10H12V8H18V2ZM12 4H16V6H12ZM20 2V10H22V4H24V10H26V4H28V10H30V2Z"/>
    </svg>
  </a>}
  {homepage && <a class="platform-link" data-platform="homepage" href={homepage} aria-label={name+' · '+homepageLabel} title={name+' · '+homepageLabel}>
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="9.25" />
      <path d="M2.75 12h18.5M12 2.75c3 2.8 4.3 5.88 4.3 9.25S15 18.45 12 21.25M12 2.75C9 5.55 7.7 8.63 7.7 12S9 18.45 12 21.25" />
    </svg>
  </a>}
  {docs && <a class:list={['platform-link', {'project-destination': docsPrimary}]} data-platform="docs" href={docs} aria-label={name+' · '+docsLabel} title={name+' · '+docsLabel}>
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 3.5h9.5l4.5 4.75v12.25H5zM14.5 3.5v4.75H19M8.5 12h7M8.5 15.5h7" />
    </svg>
    <span>{docsLabel}</span>
  </a>}
</div>
