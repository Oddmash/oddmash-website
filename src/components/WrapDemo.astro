---
import { copy, labels, languageNames, locales, type Locale } from '../content';
import { homepageNames, projectLinks } from '../localized';
const {locale} = Astro.props as {locale:Locale};
const t = copy[locale];
const l = labels[locale];
const live = projectLinks('juliya', locale).live ?? 'https://oddmash.github.io/juliya/';
const samples: Record<Locale,string> = {
  ko: '팀의 모든 문서를 한곳에서 관리하고 더 자연스럽게 읽을 수 있습니다.',
  en: 'Keep your team’s documents together and make every line easier to read.',
  ja: 'チームのすべての文書を一か所で管理し、もっと自然に読めるようにします。',
  'zh-CN': '在一个地方管理团队的所有文档，让每一行文字读起来更自然。',
};
const sample = samples[locale];
const languageLabel = {en:'Example language',ko:'예제 언어',ja:'例文の言語','zh-CN':'示例语言'}[locale];
const widthDescription = {
  en: 'The dashed guides mark the same text width in both examples.',
  ko: '점선은 두 예제에서 동일한 텍스트 폭을 표시합니다.',
  ja: '点線は両方の例文で同じテキスト幅を示します。',
  'zh-CN': '虚线标记两个示例中相同的文本宽度。',
}[locale];
---
<section class="section demo" aria-labelledby="demo-title" data-om-theme="dark">
  <p class="eyebrow">Juliya / Live</p><h2 id="demo-title">{t.demo}</h2><p>{t.demoNote}</p>
  <p id="demo-fallback">{l.demoFallback}</p>
  <div class="demo-language-control" id="demo-language-control" hidden><span id="demo-language-label">{languageLabel}</span><div id="demo-language-host" data-locale={locale} data-options={JSON.stringify(locales.map(lang=>({value:lang,label:languageNames[lang],lang})))} data-samples={JSON.stringify(samples)}></div></div>
  <div class="width-control" id="demo-control" hidden><label for="demo-width">{l.width}</label><output id="width-value" for="demo-width">220 px</output><div id="demo-slider-host"></div><p id="demo-width-description">{widthDescription}</p></div>
  <div class="demo-pair" id="demo-pair" hidden>
    <div><p class="tag">{t.before}</p><p id="native-wrap" class="sample" lang={locale}>{sample}</p></div>
    <div><p class="tag">{t.after}</p><p id="optimized-wrap" class="sample" lang={locale}>{sample}</p></div>
  </div>
  <p id="demo-status" role="status" data-failure={l.demoFailure}></p>
  <a class="text-link demo-fallback-link" href={live}>{homepageNames[locale]}</a>
</section>
<style>
  #demo-fallback[hidden] ~ .demo-fallback-link { display: none; }
  #demo-width-description { flex-basis: 100%; margin: 0; font-size: .875rem; font-weight: 400; color: var(--muted); }
  #demo-pair .sample { outline: 1px dashed var(--om-semantic-color-border); outline-offset: 3px; }
</style>
<script>
import { mountKowrap as mountJuliya } from '@oddmash/juliya/dom';
import { SelectDropdown, type SelectDropdownOption } from '@oddmash/ui/select';
import { Slider } from '@oddmash/ui/slider';
import { createElement } from 'react';
import { createRoot } from 'react-dom/client';
import { flushSync } from 'react-dom';
const sliderHost = document.querySelector<HTMLElement>('#demo-slider-host');
const languageHost = document.querySelector<HTMLElement>('#demo-language-host');
const pair = document.querySelector<HTMLElement>('#demo-pair');
const value = document.querySelector<HTMLOutputElement>('#width-value');
const title = document.querySelector<HTMLElement>('#optimized-wrap');
const native = document.querySelector<HTMLElement>('#native-wrap');
const languageControl = document.querySelector<HTMLElement>('#demo-language-control');
const control = document.querySelector<HTMLElement>('#demo-control');
const fallback = document.querySelector<HTMLElement>('#demo-fallback');
const status = document.querySelector<HTMLElement>('#demo-status');
if (sliderHost && languageHost && pair && value && title && native && languageControl && control && fallback && status) {
  const samples = JSON.parse(languageHost.dataset.samples ?? '{}') as Record<string,string>;
  const options = JSON.parse(languageHost.dataset.options ?? '[]') as SelectDropdownOption[];
  let selectedLanguage = languageHost.dataset.locale ?? 'en';
  let range: HTMLInputElement | null = null;
  pair.hidden = false;
  const updateLimit = () => {
    const widths = Array.from(pair.children, panel => {
      const style = getComputedStyle(panel);
      return panel.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
    });
    const max = Math.max(160, Math.min(320, Math.floor(Math.min(...widths) / 10) * 10));
    if (range) range.max = String(max);
  };
  const update = () => { if (range) { pair.style.setProperty('--sample-width', range.value+'px'); value.value = range.value+' px'; } };
  let controller: ReturnType<typeof mountJuliya> | undefined;
  const applySample = () => {
    const lang = selectedLanguage;
    const locale = lang === 'zh-CN' ? 'zh-Hans' : lang === 'ko' || lang === 'ja' ? lang : 'en';
    const text = samples[lang] ?? '';
    native.textContent = text;
    native.lang = lang;
    title.lang = lang;
    if (controller) controller.update({text,locale});
    else controller = mountJuliya(title,{text,locale});
  };
  let cleanup: (() => void) | undefined;
  const mountControls = () => {
    if (range) return;
    const selectRoot = createRoot(languageHost);
    const sliderRoot = createRoot(sliderHost);
    flushSync(() => {
      selectRoot.render(createElement(SelectDropdown, {
        id:'demo-language', 'aria-labelledby':'demo-language-label', options, defaultValue:selectedLanguage,
        onValueChange: lang => { selectedLanguage = lang; if (cleanup) applySample(); },
      }));
      sliderRoot.render(createElement(Slider, {id:'demo-width','aria-describedby':'demo-width-description',min:160,max:320,step:10,defaultValue:220}));
    });
    range = sliderHost.querySelector<HTMLInputElement>('#demo-width');
    if (!range || !languageHost.querySelector('#demo-language')) throw new Error('Missing demo controls');
  };
  const start = () => {
    if (cleanup) return;
    try {
      mountControls();
      if (!range) throw new Error('Missing demo slider');
      const input = range;
      pair.hidden = false;
      updateLimit();
      update();
      applySample();
      const observer = new ResizeObserver(() => { updateLimit(); update(); });
      cleanup = () => {
        observer.disconnect();
        input.removeEventListener('input', update);
        cleanup = undefined;
      };
      for (const panel of pair.children) observer.observe(panel);
      input.addEventListener('input', update);
      control.hidden = false;
      languageControl.hidden = false;
      fallback.hidden = true;
      status.textContent = '';
    } catch {
      cleanup?.();
      controller?.destroy();
      controller = undefined;
      pair.hidden = true;
      control.hidden = true;
      languageControl.hidden = true;
      fallback.hidden = false;
      status.textContent = status.dataset.failure ?? '';
    }
  };
  window.addEventListener('pagehide', () => cleanup?.());
  window.addEventListener('pageshow', event => { if (event.persisted) start(); });
  start();
}
</script>
