---
import { copy, type Locale } from '../content';
const {locale} = Astro.props as {locale:Locale};
const t = copy[locale];
const sample = '팀의 모든 문서를 한곳에서 관리하고 더 자연스럽게 읽을 수 있습니다.';
---
<section class="section demo" aria-labelledby="demo-title">
  <p class="eyebrow">Kowrap / Live</p><h2 id="demo-title">{t.demo}</h2><p>{t.demoNote}</p>
  <label class="width-control" for="demo-width">{locale==='ko'?'너비':locale==='ja'?'幅':locale==='zh-CN'?'宽度':'Width'} <output id="width-value">220 px</output><input id="demo-width" type="range" min="160" max="320" step="10" value="220" /></label>
  <div class="demo-pair" id="demo-pair">
    <div><p class="tag">{t.before}</p><p class="sample" lang="ko">{sample}</p></div>
    <div><p class="tag">{t.after}</p><p id="optimized-wrap" class="sample" lang="ko">{sample}</p></div>
  </div>
  <p id="demo-status" role="status" data-failure={locale==='ko'?'Kowrap을 사용할 수 없습니다. 체험 페이지를 열어 주세요.':locale==='ja'?'Kowrapを利用できません。体験ページをご覧ください。':locale==='zh-CN'?'Kowrap 暂不可用。请访问体验页面。':'Kowrap unavailable. Visit the playground.'}></p>
  <a class="text-link" href="https://oddmash.github.io/kowrap/#playground">{t.live}</a>
</section>
<script>
import { mountKowrap } from '@oddmash/kowrap/browser';
const range = document.querySelector<HTMLInputElement>('#demo-width');
const pair = document.querySelector<HTMLElement>('#demo-pair');
const value = document.querySelector<HTMLOutputElement>('#width-value');
const title = document.querySelector<HTMLElement>('#optimized-wrap');
if (range && pair && value && title) {
  const update = () => { pair.style.setProperty('--sample-width', range.value+'px'); value.value = range.value+' px'; };
  range.addEventListener('input', update);
  update();
  try { mountKowrap(title, {text:title.textContent ?? ''}); }
  catch { const status = document.querySelector<HTMLElement>('#demo-status'); if(status) status.textContent = status.dataset.failure ?? ''; }
}
</script>
