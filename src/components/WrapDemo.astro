---
import { copy, labels, languageNames, locales, type Locale } from '../content';
import { projectLinks } from '../localized';
const {locale} = Astro.props as {locale:Locale};
const t = copy[locale];
const l = labels[locale];
const live = projectLinks('juliya', locale).live ?? 'https://oddmash.github.io/juliya/';
const samples: Record<Locale,string> = {
  ko: '팀의 모든 문서를 한곳에서 관리하고 더 자연스럽게 읽을 수 있습니다.',
  en: 'Keep your team’s documents together and make every line easier to read.',
  ja: 'チームのすべての文書を一か所で管理し、もっと自然に読めるようにします。',
  'zh-CN': '在一个地方管理团队的所有文档，让每一行文字读起来更自然。',
};
const sample = samples[locale];
const languageLabel = {en:'Example language',ko:'예제 언어',ja:'例文の言語','zh-CN':'示例语言'}[locale];
---
<section class="section demo" aria-labelledby="demo-title">
  <p class="eyebrow">Juliya / Live</p><h2 id="demo-title">{t.demo}</h2><p>{t.demoNote}</p>
  <p id="demo-fallback">{l.demoFallback}</p>
  <label class="demo-language-control" id="demo-language-control" hidden>{languageLabel}<select id="demo-language">{locales.map(lang=><option value={lang} selected={lang===locale} data-sample={samples[lang]}>{languageNames[lang]}</option>)}</select></label>
  <label class="width-control" for="demo-width" id="demo-control" hidden>{l.width} <output id="width-value" for="demo-width">220 px</output><input id="demo-width" type="range" min="160" max="320" step="10" value="220" /></label>
  <div class="demo-pair" id="demo-pair" hidden>
    <div><p class="tag">{t.before}</p><p id="native-wrap" class="sample" lang={locale}>{sample}</p></div>
    <div><p class="tag">{t.after}</p><p id="optimized-wrap" class="sample" lang={locale}>{sample}</p></div>
  </div>
  <p id="demo-status" role="status" data-failure={l.demoFailure}></p>
  <a class="text-link" href={live}>{t.live}</a>
</section>
<script>
import { mountKowrap as mountJuliya } from '@oddmash/juliya/dom';
const range = document.querySelector<HTMLInputElement>('#demo-width');
const pair = document.querySelector<HTMLElement>('#demo-pair');
const value = document.querySelector<HTMLOutputElement>('#width-value');
const title = document.querySelector<HTMLElement>('#optimized-wrap');
const native = document.querySelector<HTMLElement>('#native-wrap');
const language = document.querySelector<HTMLSelectElement>('#demo-language');
const languageControl = document.querySelector<HTMLElement>('#demo-language-control');
const control = document.querySelector<HTMLElement>('#demo-control');
const fallback = document.querySelector<HTMLElement>('#demo-fallback');
const status = document.querySelector<HTMLElement>('#demo-status');
if (range && pair && value && title && native && language && languageControl && control && fallback && status) {
  pair.hidden = false;
  const updateLimit = () => {
    const widths = Array.from(pair.children, panel => {
      const style = getComputedStyle(panel);
      return panel.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
    });
    const max = Math.max(160, Math.min(320, Math.floor(Math.min(...widths) / 10) * 10));
    range.max = String(max);
  };
  const update = () => { pair.style.setProperty('--sample-width', range.value+'px'); value.value = range.value+' px'; };
  let controller: ReturnType<typeof mountJuliya> | undefined;
  const applySample = () => {
    const lang = language.value;
    const locale = lang === 'zh-CN' ? 'zh-Hans' : lang === 'ko' || lang === 'ja' ? lang : 'en';
    const text = language.selectedOptions[0]?.dataset.sample ?? '';
    native.textContent = text;
    native.lang = lang;
    title.lang = lang;
    if (controller) controller.update({text,locale});
    else controller = mountJuliya(title,{text,locale});
  };
  let cleanup: (() => void) | undefined;
  const start = () => {
    if (cleanup) return;
    try {
      pair.hidden = false;
      updateLimit();
      update();
      applySample();
      const observer = new ResizeObserver(() => { updateLimit(); update(); });
      cleanup = () => {
        observer.disconnect();
        range.removeEventListener('input', update);
        language.removeEventListener('change', applySample);
        cleanup = undefined;
      };
      for (const panel of pair.children) observer.observe(panel);
      range.addEventListener('input', update);
      language.addEventListener('change', applySample);
      control.hidden = false;
      languageControl.hidden = false;
      fallback.hidden = true;
      status.textContent = '';
    } catch {
      cleanup?.();
      controller?.destroy();
      controller = undefined;
      pair.hidden = true;
      control.hidden = true;
      languageControl.hidden = true;
      fallback.hidden = false;
      status.textContent = status.dataset.failure ?? '';
    }
  };
  window.addEventListener('pagehide', () => cleanup?.());
  window.addEventListener('pageshow', event => { if (event.persisted) start(); });
  start();
}
</script>
