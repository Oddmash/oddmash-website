---
import type { Locale } from '../content';
import { labCopy } from '../lab-content';
import FilmScene from './FilmScene.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = labCopy[locale];
const controls = {
  en: {
    lead: 'See how a change moves from a real issue through implementation, review and a verified public release.',
    hint: 'Hover or focus to pause. Tap to pause or resume on touch screens.',
  },
  ko: {
    lead: '실제 이슈에서 시작한 변경이 구현, 검토, 검증을 거쳐 공개 배포에 이르는 과정을 확인해 보세요.',
    hint: '마우스를 올리거나 키보드로 선택하면 일시 정지합니다. 터치 화면에서는 탭으로 정지하거나 재개합니다.',
  },
  ja: {
    lead: '実際の課題から始まる変更が実装、レビュー、検証を経て公開されるまでをご覧ください。',
    hint: 'ホバーまたはフォーカスで一時停止。タッチ画面ではタップで切り替えます。',
  },
  'zh-CN': {
    lead: '了解一项改动如何从实际问题出发，经过实现、审查和验证，最终公开发布。',
    hint: '悬停或聚焦时暂停。触屏上轻触暂停或继续。',
  },
}[locale];
---
<section class="section lab-workflow" id="workflow" aria-labelledby="workflow-title">
  <div class="section-title">
    <h2 id="workflow-title" tabindex="-1">{c.workflowTitle}</h2>
    <p>{controls.lead}</p>
  </div>
  <div class="film-player" hidden tabindex="0" role="region" aria-labelledby="workflow-title" aria-describedby="film-hint">
    <div class="film-screen">
      {c.steps.map((step, index) => <article class="film-visual" data-film-visual={index} hidden={index !== 0}>
        <div class="film-scene" aria-hidden="true"><FilmScene locale={locale} index={index} /></div>
        <div class="film-step-copy">
          <h3>{step.title}</h3>
          <p>{step.body}</p>
          <span class="film-outcome">{step.artifact}: {step.signal}</span>
        </div>
      </article>)}
    </div>
    <p class="film-hint" id="film-hint">{controls.hint}</p>
  </div>
  <ol class="film-steps" role="list">
    {c.steps.map((step, index) => <li class="film-step" id={'workflow-step-' + (index + 1)} data-film-step={index}>
      <div class="film-step-copy">
        <h3>{step.title}</h3>
        <p>{step.body}</p>
        <span class="film-outcome">{step.artifact}: {step.signal}</span>
      </div>
      <div class="film-inline" aria-hidden="true"><FilmScene locale={locale} index={index} /></div>
    </li>)}
  </ol>
</section>
<script>
const root = document.querySelector<HTMLElement>('#workflow');
if (root && 'IntersectionObserver' in window) {
  const player = root.querySelector<HTMLElement>('.film-player');
  const fallback = root.querySelector<HTMLElement>('.film-steps');
  const slides = [...root.querySelectorAll<HTMLElement>('[data-film-visual]')];
  if (player && fallback && slides.length) {
    const media = matchMedia('(prefers-reduced-motion: reduce)');
    const duration = 3600;
    let index = 0;
    let remaining = duration;
    let timer: number | undefined;
    let started = 0;
    let inView = false;
    let pageActive = true;
    let hovered = false;
    let focused = false;
    let touchPaused = false;
    const render = () => {
      root.dataset.activeScene = String(index);
      for (const [i, slide] of slides.entries()) slide.hidden = i !== index;
    };
    const canPlay = () => !media.matches && pageActive && inView && !document.hidden && !hovered && !focused && !touchPaused;
    const stopTimer = () => {
      if (timer === undefined) return;
      clearTimeout(timer);
      timer = undefined;
      remaining = Math.max(0, remaining - (performance.now() - started));
    };
    const sync = () => {
      const playing = canPlay();
      if (!media.matches) {
        root.dataset.playing = String(playing);
        root.dataset.filmAnimate = 'true';
      }
      if (!playing) stopTimer();
      else if (timer === undefined) {
        started = performance.now();
        timer = window.setTimeout(() => {
          timer = undefined;
          if (!canPlay()) { sync(); return; }
          index = (index + 1) % slides.length;
          remaining = duration;
          render();
          sync();
        }, remaining);
      }
    };
    const syncMotion = () => {
      if (media.matches && player.contains(document.activeElement)) root.querySelector<HTMLElement>('#workflow-title')?.focus();
      player.hidden = media.matches;
      fallback.hidden = !media.matches;
      if (media.matches) {
        delete root.dataset.filmReady;
        delete root.dataset.activeScene;
        delete root.dataset.playing;
        delete root.dataset.filmAnimate;
      } else {
        root.dataset.filmReady = 'true';
        render();
      }
      sync();
    };
    player.addEventListener('pointerenter', event => { if (event.pointerType === 'mouse') { hovered = true; sync(); } });
    player.addEventListener('pointerleave', event => { if (event.pointerType === 'mouse') { hovered = false; sync(); } });
    player.addEventListener('focusin', () => { focused = true; if (player.matches(':focus-visible')) touchPaused = false; sync(); });
    player.addEventListener('focusout', () => { focused = false; sync(); });
    player.addEventListener('pointerup', event => { if (event.pointerType === 'touch') { focused = false; touchPaused = !touchPaused; sync(); } });
    const observer = new IntersectionObserver(entries => {
      inView = !!entries[0]?.isIntersecting && entries[0].intersectionRatio >= .1;
      sync();
    }, { threshold: [0, .1] });
    observer.observe(player);
    media.addEventListener('change', syncMotion);
    document.addEventListener('visibilitychange', sync);
    window.addEventListener('pagehide', () => { pageActive = false; sync(); });
    window.addEventListener('pageshow', () => { pageActive = true; syncMotion(); });
    syncMotion();
  }
}
</script>
