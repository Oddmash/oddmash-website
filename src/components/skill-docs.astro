---
import { url, type Locale } from '../content';
import { skills, skillCopy, skillName, skillSummary, findSkill, skillRevision } from '../skill-content';
import { guideFor, skillStages } from '../skill-guide';

interface Props { locale: Locale; path: string }
const { locale, path } = Astro.props;
const t = skillCopy[locale];
const skill = findSkill(path);
const stage = skill && skillStages.find(item=>item.skills.includes(skill.id));
const labels = {
 en:{flow:'Development workflow',hint:'Choose a stage to find relevant skills.',how:'How it works',when:'When to use it',result:'Expected result',copy:'Copy Markdown',add:'Add skill',copied:'Copied',failed:'Select and copy the text manually.',install:'Install on your device',installBody:'Run these commands from your terminal. The checkout preserves related references. If you already have the repository, reuse its existing path. Existing skill names will not be overwritten. Start a new Codex session after installing.',all:'For all shared skills, use the official installer from the repository checkout: python3 scripts/install.py.',copyCommand:'Copy install commands',original:'View source',outputs:['A scoped issue with measurable acceptance criteria.','An intentional design with verified behavior and visual states.','A focused implementation with a reproducible example or build.','Recorded observed checks, failures and limitations.','A traceable review decision linked to exact changes.','An approved candidate with a verified public result.','An evidence-based maintenance or improvement plan.']},
 ko:{flow:'개발 과정',hint:'단계를 선택하면 관련 스킬을 바로 확인할 수 있습니다.',how:'어떻게 동작하나요?',when:'언제 사용하나요?',result:'기대 결과',copy:'Markdown 복사',add:'스킬 추가하기',copied:'복사했습니다',failed:'아래 텍스트를 선택해 직접 복사하세요.',install:'내 환경에 설치하기',installBody:'터미널에서 명령을 실행하세요. 저장소를 함께 내려받으므로 참조 파일도 유지됩니다. 이미 저장소가 있다면 기존 경로를 사용하세요. 같은 이름의 스킬은 덮어쓰지 않습니다. 설치 후 새 Codex 세션을 시작하세요.',all:'전체 공용 스킬을 설치하려면 저장소에서 공식 설치 명령 python3 scripts/install.py 를 실행하세요.',copyCommand:'설치 명령 복사',original:'원본 보기',outputs:['범위와 측정 가능한 완료 조건이 명확한 이슈.','실제 화면과 동작 상태로 확인한 디자인.','실행 가능한 예제 또는 빌드로 검증한 구현.','관찰한 검사 결과, 실패 조건 및 미검증 범위를 기록한 근거.','정확한 변경과 연결된 추적 가능한 리뷰 결과.','승인된 변경과 실제 공개 결과가 확인된 릴리스.','실제 근거를 바탕으로 정리한 운영 또는 개선 계획.']},
 ja:{flow:'開発の流れ',hint:'段階を選び、関連するスキルを確認します。',how:'どのように動作するか',when:'利用する場面',result:'期待する結果',copy:'Markdown をコピー',add:'スキルを追加',copied:'コピーしました',failed:'テキストを選択してコピーしてください。',install:'端末にインストール',installBody:'ターミナルで実行します。既存のチェックアウトがあれば再利用し、同じ名前は上書きしません。インストール後に新しい Codex セッションを開始します。',all:'全スキルはチェックアウトで python3 scripts/install.py を実行します。',copyCommand:'インストールコマンドをコピー',original:'原本を見る',outputs:['範囲と完了条件を定義した Issue。','画面と操作で確認した設計。','再現可能な実装。','観測した検証結果。','変更と対応を追跡できるレビュー。','実際に確認した公開結果。','根拠のある運用計画。']},
 'zh-CN':{flow:'开发流程',hint:'选择阶段，查看相关技能。',how:'如何运作',when:'使用场景',result:'预期结果',copy:'复制 Markdown',add:'添加技能',copied:'已复制',failed:'请手动选择并复制文本。',install:'安装到设备',installBody:'在终端运行命令。已有仓库时请复用路径；不会覆盖同名技能。安装后启动新的 Codex 会话。',all:'安装所有共享技能：在仓库内运行 python3 scripts/install.py。',copyCommand:'复制安装命令',original:'查看原文',outputs:['范围和验收标准清晰的问题。','通过真实画面验证的设计。','可复现的实现。','记录实际验证结果。','与变更对应的可追溯审查。','已验证的公开发布结果。','有证据支持的维护计划。']}
}[locale];
const stageIndex=stage ? skillStages.indexOf(stage) : 0;
const skillId=skill ? 'oddmash-'+skill.id : '';
const markdown=skill ? '---\nname: '+skillId+'\ndescription: '+JSON.stringify(skill.description)+'\n---\n\n'+skill.source+'\n' : '';
const commands=skill ? ['test -d "$HOME/.oddmash-skills/.git" || git clone https://github.com/Oddmash/oddmash-skills.git "$HOME/.oddmash-skills"','mkdir -p "$HOME/.agents/skills"','test -f "$HOME/.oddmash-skills/skills/'+skillId+'/SKILL.md" && test ! -e "$HOME/.agents/skills/'+skillId+'" && test ! -L "$HOME/.agents/skills/'+skillId+'" && ln -s "$HOME/.oddmash-skills/skills/'+skillId+'" "$HOME/.agents/skills/'+skillId+'"'].join('\n') : '';
---
{skill ? <article class="agent-doc skill-doc">
  <header class="detail-head agent-doc-heading">
    <a class="text-link" href={url(locale,'skills')}>← {t.back}</a>
    <p class="eyebrow">Oddmash Skills {stage && ' / '+stage[locale]}</p>
    <h1>{skillName(skill,locale)}</h1>
    <p class="lead" lang={locale}>{skillSummary(skill,locale)}</p>
    <div class="actions skill-actions" data-copy-scope>
      <button type="button" class="button secondary" data-copy="markdown" data-success={labels.copied} data-failure={labels.failed}>{labels.copy}</button>
      <a class="button primary" href="#skill-install">{labels.add}</a>
      <textarea data-copy-source="markdown" class="skill-copy-source" hidden readonly aria-label={labels.copy}>{markdown}</textarea>
      
    </div>
  </header>
  <section class="section agent-doc-section skill-reference">
    <h2>{labels.when}</h2><p>{skillSummary(skill,locale)}</p>
    <h2>{labels.how}</h2><p>{guideFor(skill.id,locale)}</p>
    <h2>{labels.result}</h2><p>{labels.outputs[stageIndex]}</p>
    {stage && <div class="skill-related"><h3>{labels.flow}: {stage[locale]}</h3>{skills.filter(item=>stage.skills.includes(item.id)&&item.id!==skill.id).map(item=><a class="text-link" href={url(locale,'skills/'+item.id)}>{skillName(item,locale)} →</a>)}</div>}
    <a class="text-link" href={`https://github.com/Oddmash/oddmash-skills/blob/${skillRevision}/${skill.path}`}>{labels.original} ↗</a>
  </section>
  <section class="section agent-doc-section skill-install" id="skill-install" data-copy-scope>
    <h2>{labels.install}</h2><p>{labels.installBody}</p>
    <pre><code>{commands}</code></pre>
    <button type="button" class="button secondary" data-copy="commands" data-success={labels.copied} data-failure={labels.failed}>{labels.copyCommand}</button>
    <textarea data-copy-source="commands" class="skill-copy-source" hidden readonly aria-label={labels.copyCommand}>{commands}</textarea>
    <p>{labels.all}</p>
  </section>
</article> : <div class="agent-doc skill-doc">
  <header class="detail-head agent-doc-heading"><p class="eyebrow">Oddmash</p><h1>{t.title}</h1><p class="lead">{t.intro}</p></header>
  <section class="section skill-flow-section" aria-labelledby="skill-flow-title">
    <div class="section-title"><h2 id="skill-flow-title">{labels.flow}</h2><p>{labels.hint}</p></div>
    <div class="skill-flow-controls" data-skill-flow-controls hidden role="group" aria-label={labels.flow}>
      {skillStages.map((item,index)=><button type="button" data-stage-select={item.id} aria-controls={'skill-stage-'+item.id} aria-pressed={index===0?'true':'false'}><span class="skill-flow-node" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><strong>{item[locale]}</strong><span class="skill-flow-count">{item.skills.length}</span></button>)}
    </div>
    {skillStages.map(item=><section class="skill-flow-panel" id={'skill-stage-'+item.id} data-stage-panel={item.id} aria-labelledby={'skill-stage-title-'+item.id}>
      <h3 id={'skill-stage-title-'+item.id}>{item[locale]}</h3>
      <div class="skill-grid">{skills.filter(skill=>item.skills.includes(skill.id)).map(skill=><a class="skill-item" href={url(locale,'skills/'+skill.id)}><h4>{skillName(skill,locale)}</h4><p lang={locale}>{skillSummary(skill,locale)}</p></a>)}</div>
    </section>)}
  </section>
  <section class="section agent-doc-section"><a class="text-link" href={url(locale,'agents')}>{locale==='ko'?'에이전트 문서':locale==='ja'?'エージェント':locale==='zh-CN'?'智能体文档':'Agent documentation'} →</a></section>
</div>}
<script>
import { notifyCopy } from '../copy-toast';
const controls=document.querySelector<HTMLElement>('[data-skill-flow-controls]');
if(controls){
  const buttons=[...controls.querySelectorAll<HTMLButtonElement>('[data-stage-select]')];
  const panels=[...document.querySelectorAll<HTMLElement>('[data-stage-panel]')];
  const setStage=(id:string)=>{
    for(const button of buttons) button.setAttribute('aria-pressed',String(button.dataset.stageSelect===id));
    for(const panel of panels) panel.hidden=panel.dataset.stagePanel!==id;
  };
  controls.hidden=false;
  if(buttons[0]?.dataset.stageSelect) setStage(buttons[0].dataset.stageSelect);
  for(const button of buttons){
    const activate=()=>{if(button.dataset.stageSelect) setStage(button.dataset.stageSelect);};
    button.addEventListener('click',activate);
  }
}
for(const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')){
  button.addEventListener('click',async()=>{
    const scope=button.closest('[data-copy-scope]');
    const input=scope?.querySelector<HTMLTextAreaElement>('[data-copy-source="'+button.dataset.copy+'"]');
    if(!input)return;
    try{await navigator.clipboard.writeText(input.value);input.hidden=true;notifyCopy(button.dataset.success??'');}
    catch{input.hidden=false;input.focus();input.select();notifyCopy(button.dataset.failure??'',true);}
  });
}
</script>
