---
import { url, type Locale } from '../content';
import { agentDocsCopy, findAgentRole } from '../agent-content';
import { labCopy } from '../lab-content';
import AgentCharacter from './agent-character.astro';
import AgentRoster from './agent-roster.astro';
import '../styles/agent-roster.scss';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const t = agentDocsCopy[locale];
const role = findAgentRole(path);
const detail = role ? t.roles[role.id] : undefined;
const guide = {
 en:{title:'Request a review',body:'In an open pull request, write one standalone slash command on the first non-empty line of a comment. Use /review for Lead and the relevant specialist command for a focused advisory. Triage accepts /triage on an open issue only.',example:'Add optional context on later lines. Do not send multiple commands in one comment. An installed, enabled specialist responds under its own identity.',results:'Read the result',resultBody:'Lead considers required CI and concrete review evidence before issuing a formal result. Specialist comments are advice, not approvals. A pending review may wait for the current head checks; a new push invalidates old evidence. Address an actionable finding or document why it is not adopted in the original review thread.',skills:'How skills support agents',skillsBody:'Skills define reusable work and verification methods. Agents use relevant guidance, repository rules, and observed evidence; the maintainer retains release and permission decisions.'},
 ko:{title:'리뷰 요청 방법',body:'열린 PR 댓글의 첫 번째 비어 있지 않은 줄에 슬래시 명령 하나를 작성하세요. 정식 리뷰는 /review, 전문 검토는 해당 역할 명령을 사용합니다. Triage의 /triage는 열린 이슈에서만 사용할 수 있습니다.',example:'다음 줄에 검토할 맥락을 추가할 수 있습니다. 한 댓글에 여러 명령을 넣지 마세요. 해당 저장소에 활성화된 전문 에이전트가 자신의 계정으로 응답합니다.',results:'리뷰 결과 확인',resultBody:'Lead는 현재 커밋의 필수 CI와 구체적인 검토 근거로 정식 리뷰 결과를 결정합니다. 전문 에이전트의 의견은 승인과 다릅니다. CI 대기 중에는 리뷰가 보류될 수 있으며 새 커밋을 올리면 이전 검토는 최신 근거가 아닙니다. 지적 사항을 수정하거나 반영하지 않는 이유를 원래 리뷰 스레드에 남기고 검증 결과를 확인하세요.',skills:'스킬과 에이전트의 관계',skillsBody:'스킬은 재사용 가능한 작업 방식과 검증 기준입니다. 에이전트는 적용 가능한 스킬, 프로젝트 지침과 관찰된 근거로 검토하며, 권한 및 공개 배포 결정은 유지보수 담당자의 책임입니다.'},
 ja:{title:'レビューの依頼',body:'開いている PR のコメントの最初の空白でない行に、スラッシュコマンドを一つ記入します。正式レビューは /review、専門家には個別のコマンドを使います。/triage は開いている Issue が対象です。',example:'次の行に補足情報を追加できます。複数のコマンドを一つのコメントに含めないでください。',results:'結果を確認する',resultBody:'Lead は現在の CI と根拠を確認して正式な結果を出します。専門家の助言は承認ではありません。新しい変更後は最新の検証を確認し、指摘への対応を元のスレッドに記録します。',skills:'スキルとエージェント',skillsBody:'スキルは再利用可能な作業および検証ガイドです。公開判断と権限はメンテナーが管理します。'},
 'zh-CN':{title:'请求审查',body:'在开放 PR 的评论第一行非空行输入一个独立的斜杠命令。正式审查使用 /review，专项审查使用对应命令。/triage 仅用于开放的问题。',example:'可在下一行添加上下文，不要在同一评论中输入多个命令。',results:'查看结果',resultBody:'Lead 根据当前 CI 和具体证据给出正式结果。专项建议不代表批准。新的提交需要重新验证，并在原审查线程记录处理结果。',skills:'技能和智能体',skillsBody:'技能是可复用的工作和验证指南。维护者负责权限和发布决策。'}
}[locale];
---

{role && detail ? (
  <article class="agent-doc">
    <header class="detail-head agent-doc-heading agent-role-heading">
      <div>
        <a class="text-link agent-back-link" href={url(locale, 'agents')}>{t.back}</a>
        <p class="eyebrow">{role.id === 'lead' ? t.auto : t.request}</p>
        <h1>{role.name}</h1>
        <p class="lead">{labCopy[locale].agentDescriptions[role.id]}</p>
      </div>
      <div class="agent-doc-art"><AgentCharacter id={role.id} color={role.color} /></div>
    </header>
    <section class="section agent-doc-section" aria-labelledby="agent-usage">
      <h2 id="agent-usage">{t.focus}</h2>
      <p>{detail.focus}</p>
      <div class="agent-command-card">
        <div>
          <p class="eyebrow">{t.context}</p>
          <p>{role.target === 'issue' ? t.issue : t.pr}</p>
        </div>
        <div>
          <p class="eyebrow">{t.command}</p>
          <code>{role.command}</code>
        </div>
      </div>
      <p>{t.commandBody}</p>
    </section>
    <section class="section agent-doc-section" aria-labelledby="agent-checks">
      <h2 id="agent-checks">{t.checks}</h2>
      <ul class="feature-list">{detail.checks.map(check => <li>{check}</li>)}</ul>
    </section>
    <section class="section agent-doc-section" aria-labelledby="agent-output">
      <h2 id="agent-output">{t.output}</h2>
      <p>{detail.output}</p>
    </section>
    <section class="section agent-doc-section" aria-labelledby="agent-example">
      <h2 id="agent-example">{t.example}</h2>
      <p>{detail.example}</p>
    </section>
    <section class="section agent-doc-section" aria-labelledby="agent-boundary">
      <h2 id="agent-boundary">{t.boundary}</h2>
      <p>{detail.boundary}</p>
      <div class="actions">
        <a class="text-link" href={url(locale, 'agents')}><span aria-hidden="true">←</span>{t.back}</a>
        <a class="text-link" href="https://github.com/Oddmash/oddmash-agents/blob/main/docs/agent-family.md">{t.repositoryDocs}</a>
      </div>
    </section>
  </article>
) : (
  <div class="agent-doc">
    <header class="detail-head agent-doc-heading">
      <p class="eyebrow">Oddmash</p>
      <h1>{t.title}</h1>
      <p class="lead">{t.intro}</p>
      <div class="actions agent-doc-links">
        <a class="button secondary" href="https://github.com/Oddmash/oddmash-agents">{t.repository}<span aria-hidden="true">↗</span></a>
        <a class="button secondary" href={url(locale,'skills')}>{t.skills}<span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <AgentRoster locale={locale} compact={false} />
    <section class="section agent-doc-section" aria-labelledby="agent-invocation">
      <h2 id="agent-invocation">{t.invocation}</h2>
      <p>{t.invocationBody}</p><h3>{guide.title}</h3><p>{guide.body}</p><pre><code>/review</code></pre><p>{guide.example}</p><h3>{guide.results}</h3><p>{guide.resultBody}</p><h3>{guide.skills}</h3><p>{guide.skillsBody}</p><a class="text-link" href={url(locale,'skills')}>{t.skills} →</a>
    </section>
    <section class="section agent-doc-section" aria-labelledby="agent-guardrails">
      <h2 id="agent-guardrails">{t.guardrailTitle}</h2>
      <p>{t.guardrail}</p>
      <a class="text-link" href={url(locale) + '#method'}>{labCopy[locale].methodNav}<span aria-hidden="true">→</span></a>
    </section>
  </div>
)}
