---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectImage from '../components/ProjectImage.astro';
import WrapDemo from '../components/WrapDemo.astro';
import { copy, labels, projects, staticPages, url, type Locale, type ProjectId } from '../content';
export function getStaticPaths() {
  return staticPages.map(page=>({params:{route:page.href.replace(/^\/+|\/+$/g,'') || undefined}, props:{locale:page.locale,path:page.path}}));
}
const {locale,path}=Astro.props as {locale:Locale;path:string};
const t=copy[locale];
const l=labels[locale];
const home=url(locale);
const project=projects.find(p=>path==='projects/'+p.id);
const details=project ? t.projects[project.id as ProjectId] : undefined;
const title=project ? project.name : path==='studio' ? t.nav[1] : path==='privacy' ? t.privacy : t.eyebrow;
const description=details?.description ?? (path==='privacy' ? t.privacyText[0] : t.intro);
---
<Base locale={locale} path={path} title={title} description={description} image={project?.id==='boundra'?undefined:project?.image} imageAlt={project?.id==='boundra'?undefined:details?.alt}>
{path==='' && <>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 id="hero-title">{t.headline.join(' ').trim()}</h1>
      <p class="lead">{t.intro}</p>
      <div class="actions"><a class="button primary" href="#work">{t.explore} <span aria-hidden="true">↓</span></a><a class="button secondary" href="https://github.com/Oddmash">{t.github} <span aria-hidden="true">↗</span></a></div>
    </div>
    <div class="brand-art" aria-hidden="true">
      <img src="/assets/oddmash-logo.png" width="320" height="320" alt="" />
    </div>
  </section>
  <section class="section" id="work" aria-labelledby="work-title">
    <div class="section-title"><h2 id="work-title">{t.work}</h2><p>{t.workIntro}</p></div>
    <div class="projects">{projects.map(project=><ProjectCard locale={locale} project={project} />)}</div>
  </section>
  <section class="section studio-summary"><div><p class="eyebrow">{l.openSource}</p><h2>{t.studio}</h2></div><div><p class="lead">{t.studioIntro}</p><a class="text-link" href={url(locale,'studio')}>{t.nav[1]} <span aria-hidden="true">↗</span></a></div></section>
  <section class="section contribute" id="contribute"><div><p class="eyebrow">{l.openSource}</p><h2>{t.contribute}</h2><p>{t.contributeText}</p></div><a class="button primary" href="https://github.com/Oddmash/.github/blob/main/CONTRIBUTING.md">{t.guide}</a></section>
</>}
{project && details && <>
  <section class="detail-head"><a class="text-link" href={home+'#work'}>{t.back}</a><p class="eyebrow">{details.type}</p><h1>{project.name}</h1><p class="lead">{details.description}</p><div class="actions">{project.live?<><a class="button primary" href={project.live}>{t.live}<span aria-hidden="true">↗</span></a><a class="button secondary" href={project.repo}>{t.repository}</a></>:<><a class="button primary" href={project.docs}>{l.setup}<span aria-hidden="true">↗</span></a><a class="button secondary" href={project.repo}>{t.repository}</a></>}{project.live&&project.docs!==project.live && <a class="text-link" href={project.docs}>{t.docs}</a>}</div>{project.package && <p class="package"><code>npm install {project.package}{project.id==='boundra'?' zod':''}</code> <a class="text-link" href={'https://www.npmjs.com/package/'+project.package}>npm ↗</a></p>}</section>
  <figure class="detail-image"><ProjectImage project={project} alt={details.alt}/><figcaption>{details.alt}</figcaption></figure>
  <section class="section detail-grid"><div><p class="eyebrow">{t.use}</p><h2>{details.summary}</h2><p class="lead">{details.use}</p></div><div><h2 class="small-heading">{t.features}</h2><ul class="feature-list">{details.features.map(value=><li>{value}</li>)}</ul></div></section>
  {project.id==='kowrap' && <WrapDemo locale={locale} />}
  <section class="section"><div class="section-title"><h2>{t.back}</h2><a class="text-link" href={home+'#work'}>{t.explore}</a></div><div class="projects">{projects.filter(p=>p.id!==project.id).map(p=><ProjectCard locale={locale} project={p} />)}</div></section>
</>}
{path==='studio' && <><section class="detail-head"><p class="eyebrow">{t.eyebrow}</p><h1>{t.studio}</h1><p class="lead">{t.studioIntro}</p></section><section class="section principle-list">{t.principles.map(([heading,body])=><div><h2>{heading}</h2><p>{body}</p></div>)}</section><section class="section contribute"><div><h2>{t.contribute}</h2><p>{t.contributeText}</p></div><a class="button primary" href="https://github.com/Oddmash/.github/blob/main/CONTRIBUTING.md">{t.guide}</a></section></>}
{path==='privacy' && <article class="policy detail-head"><p class="eyebrow">Oddmash</p><h1>{t.privacy}</h1>{t.privacyText.map(p=><p>{p}</p>)}<a class="text-link" href="https://github.com/Oddmash">GitHub</a></article>}
</Base>
<script>
if (location.pathname === '/' || location.pathname === '/oddmash-website/') {
  const legacy = new URLSearchParams(location.search).get('lang');
  const map: Record<string,string> = {ko:'/ko/',ja:'/ja/','zh-CN':'/zh-cn/'};
  if (legacy && Object.hasOwn(map,legacy)) location.replace(location.pathname.replace(/\/$/,'')+map[legacy]+location.hash);
  else if (legacy) {
    const current=new URL(location.href);
    current.searchParams.delete('lang');
    history.replaceState(null,'',current);
  }
}
</script>
