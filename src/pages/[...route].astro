---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectImage from '../components/ProjectImage.astro';
import PlatformLinks from '../components/PlatformLinks.astro';
import WrapDemo from '../components/WrapDemo.astro';
import LabStory from '../components/LabStory.astro';
import { labCopy } from '../lab-content';
import { editorial, projectLinks } from '../localized';
import { copy, projects, staticPages, url, type Locale, type ProjectId } from '../content';
import '../styles/project-interactions.scss';
import '../styles/lab-story.scss';
export function getStaticPaths() {
  return staticPages.map(page=>({params:{route:page.href.replace(/^\/+|\/+$/g,'') || undefined}, props:{locale:page.locale,path:page.path}}));
}
const {locale,path}=Astro.props as {locale:Locale;path:string};
const t=copy[locale];
const e=editorial[locale];
const lab=labCopy[locale];
const contributionUrl='https://github.com/search?q=org%3AOddmash+is%3Aissue+is%3Aopen&type=issues';
const home=url(locale);
const project=projects.find(p=>path==='projects/'+p.id);
const details=project ? t.projects[project.id as ProjectId] : undefined;
const links=project ? projectLinks(project.id,locale) : undefined;
const title=project ? project.name : path==='projects' ? t.work : path==='studio' ? e.aboutTitle : path==='privacy' ? t.privacy : t.eyebrow;
const description=details?.description ?? (path==='projects' ? t.workIntro : path==='privacy' ? t.privacyText[0] : t.intro);
---
<Base locale={locale} path={path} title={title} description={description} image={project?.id==='boundra'?undefined:project?.image} imageAlt={project?.id==='boundra'?undefined:details?.alt}>
{path==='' && <>
  <section class="hero opening-scene" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 id="hero-title">{t.headline.join(' ').trim()}</h1>
      <p class="lead">{t.intro}</p>
      <div class="actions"><a class="button primary" href="#work">{t.explore} <span aria-hidden="true">↓</span></a><PlatformLinks name="Oddmash" github="https://github.com/Oddmash" /></div>
    </div>
    <div class="brand-art" aria-hidden="true">
      <div class="scene-light"></div>
      <img src="/assets/oddmash-logo.png" width="640" height="640" alt="" fetchpriority="high" />
    </div>
  </section>
  <section class="section projects-overview" id="work" aria-labelledby="work-title">
    <div class="section-title"><h2 id="work-title">{lab.projectTitle}</h2><p>{lab.projectLead}</p></div>
    <div class="projects project-gallery">{projects.map(project=><ProjectCard locale={locale} project={project} />)}</div>
    <a class="text-link catalog-cta" href={url(locale,'projects')}>{t.back}</a>
  </section>
  <LabStory locale={locale} />
  <section class="section contribute closing-cta" id="contribute"><div><h2>{t.contribute}</h2><p>{t.contributeText}</p></div><div class="actions"><a class="button primary" href={contributionUrl}>{e.contributeAction}</a><a class="button secondary" href={url(locale,'studio')}>{t.nav[1]}</a></div></section>
</>}
{path==='projects' && <>
  <section class="detail-head"><p class="eyebrow">Oddmash</p><h1>{t.work}</h1><p class="lead">{t.workIntro}</p></section>
  <section class="section catalog-projects" aria-label={t.work}>
    {projects.map(item=>{
      const detail=t.projects[item.id];
      const destinations=projectLinks(item.id,locale);
      return <article class="catalog-entry">
        <div class="catalog-identity"><p class="tag">{detail.type}</p><h2><a class="text-link" href={url(locale,'projects/'+item.id)}>{item.name}</a></h2><ProjectImage project={item} alt={detail.alt} lazy /><PlatformLinks name={item.name} github={destinations.readme} npm={item.package} /></div>
        <div class="catalog-description"><p>{detail.description}</p><h3>{e.exampleHeading}</h3><p>{e.examples[item.id]}</p><a class="text-link" href={destinations.docs}>{item.name} {t.docs}</a></div>
      </article>;
    })}
  </section>
</>}
{project && details && links && <>
  <a class="text-link detail-back" href={url(locale,'projects')}>{t.back}</a>
  <section class="detail-head detail-hero" aria-labelledby="detail-title">
    <div class="detail-copy">
      <p class="eyebrow">{details.type}</p>
      <h1 id="detail-title">{project.name}</h1>
      <p class="detail-summary">{details.summary}</p>
      <p class="lead">{details.description}</p>
      <div class="actions">
        <PlatformLinks name={project.name} github={links.readme} npm={project.package} />
        {links.docs!==links.readme && <a class="button secondary" href={links.docs}>{t.docs}</a>}
        {links.live && <a class="text-link" href={links.live}>{t.live}</a>}
      </div>
      {project.package && <p class="package"><code>npm install {project.package}{project.id==='boundra'?' zod':''}</code></p>}
    </div>
    <figure class="detail-image"><a class="detail-image-link" href={links.live ?? links.readme} aria-label={project.name+' '+(links.live ? t.live : t.repository)}><ProjectImage project={project} alt={details.alt}/></a><figcaption>{details.alt}</figcaption></figure>
  </section>
  <section class="section detail-grid"><div><h2>{e.exampleHeading}</h2><p class="lead">{project.id==='kowrap' ? details.use : e.examples[project.id]}</p></div><div><h2 class="small-heading">{t.features}</h2><ul class="feature-list">{details.features.map(value=><li>{value}</li>)}</ul><a class="text-link" href={links.contribute}>{e.contributeAction}</a></div></section>
  {project.id==='kowrap' && <WrapDemo locale={locale} />}
  <section class="section related-projects"><div class="section-title"><h2>{t.back}</h2><a class="text-link" href={url(locale,'projects')}>{t.explore}</a></div><ul class="project-link-list">{projects.filter(p=>p.id!==project.id).map(p=><li class="project-index-row"><a class="project-destination" href={url(locale,'projects/'+p.id)}>{p.name}</a><PlatformLinks name={p.name} github={projectLinks(p.id,locale).readme} npm={p.package} /></li>)}</ul></section>
</>}
{path==='studio' && <>
  <section class="about-hero detail-head"><p class="eyebrow">Oddmash</p><h1>{e.aboutTitle}</h1><p class="lead">{e.aboutLead}</p><div class="actions"><a class="button primary" href={contributionUrl}>{e.contributeAction}</a><a class="button secondary" href={url(locale,'projects')}>{t.explore}</a></div></section>
  <section class="section about-principles" aria-labelledby="principles-title"><h2 id="principles-title">{t.studio}</h2><div class="principle-list">{t.principles.map(([heading,body])=><div><h3>{heading}</h3><p>{body}</p></div>)}</div><a class="text-link" href={home+'#method'}>{lab.methodNav}</a></section>
  <section class="section contribute"><div><h2>{e.contributeAction}</h2><p>{e.aboutContribution}</p></div><a class="button primary" href={contributionUrl}>{e.contributeAction}</a></section>
</>}
{path==='privacy' && <article class="policy detail-head"><p class="eyebrow">Oddmash</p><h1>{t.privacy}</h1>{t.privacyText.map(p=><p>{p}</p>)}<a class="text-link" href="https://github.com/Oddmash">GitHub</a></article>}
</Base>
<script>
if (location.pathname === '/' || location.pathname === '/oddmash-website/') {
  const legacy = new URLSearchParams(location.search).get('lang');
  const map: Record<string,string> = {ko:'/ko/',ja:'/ja/','zh-CN':'/zh-cn/'};
  if (legacy && Object.hasOwn(map,legacy)) location.replace(location.pathname.replace(/\/$/,'')+map[legacy]+location.hash);
  else if (legacy) {
    const current=new URL(location.href);
    current.searchParams.delete('lang');
    history.replaceState(null,'',current);
  }
}
</script>
