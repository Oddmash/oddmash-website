---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectImage from '../components/ProjectImage.astro';
import WrapDemo from '../components/WrapDemo.astro';
import { editorial, projectLinks } from '../localized';
import { copy, labels, projects, staticPages, url, type Locale, type ProjectId } from '../content';
export function getStaticPaths() {
  return staticPages.map(page=>({params:{route:page.href.replace(/^\/+|\/+$/g,'') || undefined}, props:{locale:page.locale,path:page.path}}));
}
const {locale,path}=Astro.props as {locale:Locale;path:string};
const t=copy[locale];
const e=editorial[locale];
const contributionUrl='https://github.com/search?q=org%3AOddmash+is%3Aissue+is%3Aopen&type=issues';
const l=labels[locale];
const home=url(locale);
const project=projects.find(p=>path==='projects/'+p.id);
const details=project ? t.projects[project.id as ProjectId] : undefined;
const links=project ? projectLinks(project.id,locale) : undefined;
const title=project ? project.name : path==='studio' ? e.aboutTitle : path==='privacy' ? t.privacy : t.eyebrow;
const description=details?.description ?? (path==='privacy' ? t.privacyText[0] : t.intro);
---
<Base locale={locale} path={path} title={title} description={description} image={project?.id==='boundra'?undefined:project?.image} imageAlt={project?.id==='boundra'?undefined:details?.alt}>
{path==='' && <>
  <section class="hero opening-scene" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 id="hero-title">{t.headline.join(' ').trim()}</h1>
      <p class="lead">{t.intro}</p>
      <div class="actions"><a class="button primary" href="#work">{t.explore} <span aria-hidden="true">↓</span></a><a class="button secondary" href="https://github.com/Oddmash">{t.github} <span aria-hidden="true">↗</span></a></div>
    </div>
    <div class="brand-art" aria-hidden="true">
      <div class="scene-light"></div>
      <img src="/assets/oddmash-logo.png" width="640" height="640" alt="" fetchpriority="high" />
    </div>
  </section>
  <section class="section" id="work" aria-labelledby="work-title">
    <h2 id="work-title" class="sr">{t.work}</h2>
    <div class="projects project-sequence">{projects.map(project=><ProjectCard locale={locale} project={project} />)}</div>
  </section>
  <section class="section contribute closing-cta" id="contribute"><div><h2>{e.aboutTitle}</h2><p>{e.aboutLead}</p></div><div class="actions"><a class="button primary" href={contributionUrl}>{e.contributeAction}</a><a class="button secondary" href={url(locale,'studio')}>{t.nav[1]}</a></div></section>
</>}
{project && details && links && <>
  <a class="text-link detail-back" href={home+'#work'}>{t.back}</a>
  <section class="detail-head detail-hero" aria-labelledby="detail-title">
    <div class="detail-copy">
      <p class="eyebrow">{details.type}</p>
      <h1 id="detail-title">{project.name}</h1>
      <p class="detail-summary">{details.summary}</p>
      <p class="lead">{details.description}</p>
      <div class="actions">
        <a class="button primary" href={links.readme}>{e.projectExternal}</a>
        {links.docs!==links.readme && <a class="button secondary" href={links.docs}>{t.docs}</a>}
        {links.live && <a class="text-link" href={links.live}>{t.live}</a>}
      </div>
      {project.package && <p class="package"><code>npm install {project.package}{project.id==='boundra'?' zod':''}</code><a class="text-link" href={'https://www.npmjs.com/package/'+project.package}>npm ↗</a></p>}
    </div>
    <figure class="detail-image"><ProjectImage project={project} alt={details.alt}/><figcaption>{details.alt}</figcaption></figure>
  </section>
  <section class="section detail-grid"><div><h2>{e.exampleHeading}</h2><p class="lead">{project.id==='kowrap' ? details.use : e.examples[project.id]}</p></div><div><h2 class="small-heading">{t.features}</h2><ul class="feature-list">{details.features.map(value=><li>{value}</li>)}</ul><a class="text-link" href={links.contribute}>{e.contributeAction}</a></div></section>
  {project.id==='kowrap' && <WrapDemo locale={locale} />}
  <section class="section related-projects"><div class="section-title"><h2>{t.back}</h2><a class="text-link" href={home+'#work'}>{t.explore}</a></div><ul class="project-link-list">{projects.filter(p=>p.id!==project.id).map(p=><li><a href={url(locale,'projects/'+p.id)}>{p.name}</a><a class="text-link" href={projectLinks(p.id,locale).readme}>{e.projectExternal}</a></li>)}</ul></section>
</>}
{path==='studio' && <>
  <section class="about-hero detail-head"><p class="eyebrow">Oddmash</p><h1>{e.aboutTitle}</h1><p class="lead">{e.aboutLead}</p><div class="actions"><a class="button primary" href={contributionUrl}>{e.contributeAction}</a><a class="button secondary" href={home+'#work'}>{t.explore}</a></div></section>
  <section class="section about-projects"><h2>{e.aboutProjects}</h2><ul class="project-link-list">{projects.map(p=><li><div><h3>{p.name}</h3><p>{t.projects[p.id].summary}</p></div><a class="text-link" href={projectLinks(p.id,locale).readme}>{e.projectExternal}</a></li>)}</ul></section>
  <section class="section contribute"><div><h2>{e.contributeAction}</h2><p>{e.aboutContribution}</p></div><a class="button primary" href={contributionUrl}>{e.contributeAction}</a></section>
</>}
{path==='privacy' && <article class="policy detail-head"><p class="eyebrow">Oddmash</p><h1>{t.privacy}</h1>{t.privacyText.map(p=><p>{p}</p>)}<a class="text-link" href="https://github.com/Oddmash">GitHub</a></article>}
</Base>
<script>
const motion = matchMedia('(prefers-reduced-motion: reduce)');
const chapters = document.querySelectorAll<HTMLElement>('.project-sequence .project-image');
let observer: IntersectionObserver | undefined;
const stop = () => { observer?.disconnect(); observer = undefined; };
const start = () => {
  stop();
  if(motion.matches || !('IntersectionObserver' in window)) return;
  observer = new IntersectionObserver(entries => {
    for(const entry of entries) {
      if(!entry.isIntersecting) continue;
      (entry.target as HTMLElement).dataset.sceneEntered = 'true';
      observer?.unobserve(entry.target);
    }
  }, {threshold: .18});
  for(const chapter of chapters) if(!chapter.dataset.sceneEntered) observer.observe(chapter);
};
motion.addEventListener('change', start);
window.addEventListener('pagehide', stop);
window.addEventListener('pageshow', event => { if(event.persisted) start(); });
start();
if (location.pathname === '/' || location.pathname === '/oddmash-website/') {
  const legacy = new URLSearchParams(location.search).get('lang');
  const map: Record<string,string> = {ko:'/ko/',ja:'/ja/','zh-CN':'/zh-cn/'};
  if (legacy && Object.hasOwn(map,legacy)) location.replace(location.pathname.replace(/\/$/,'')+map[legacy]+location.hash);
  else if (legacy) {
    const current=new URL(location.href);
    current.searchParams.delete('lang');
    history.replaceState(null,'',current);
  }
}
</script>
