---
import ContributionGuide from '../components/contribution-guide.astro';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectImage from '../components/ProjectImage.astro';
import ProjectStory from '../components/project-story.astro';
import PlatformLinks from '../components/PlatformLinks.astro';
import WrapDemo from '../components/WrapDemo.astro';
import LabStory from '../components/LabStory.astro';
import SkillDocs from '../components/skill-docs.astro';
import { skillCopy, findSkill, skillName, skillSummary } from '../skill-content';
import AgentDocs from '../components/agent-docs.astro';
import { agentDocsCopy, findAgentRole } from '../agent-content';
import { ecosystemCopy } from '../ecosystem-content';
import { labCopy } from '../lab-content';
import { editorial, homepageNames, projectLinks } from '../localized';
import { projectImage } from '../project-images';
import { copy, projects, staticPages, url, type Locale, type ProjectId } from '../content';
import '../styles/project-interactions.scss';
import '../styles/lab-story.scss';
export function getStaticPaths() {
  return staticPages.map(page=>({params:{route:page.href.replace(/^\/+|\/+$/g,'') || undefined}, props:{locale:page.locale,path:page.path}}));
}
const {locale,path}=Astro.props as {locale:Locale;path:string};
const t=copy[locale];
const e=editorial[locale];
const lab=labCopy[locale];
const ecosystem=ecosystemCopy[locale];
const contributionUrl='https://github.com/search?q=org%3AOddmash+is%3Aissue+is%3Aopen&type=issues';
const home=url(locale);
const project=projects.find(p=>path==='projects/'+p.id);
const details=project ? t.projects[project.id as ProjectId] : undefined;
const links=project ? projectLinks(project.id,locale) : undefined;
const skillPage=path==='skills'||path.startsWith('skills/');
const skill=findSkill(path);
const agentPage=path==='agents'||path.startsWith('agents/');
const title=skillPage ? (skill ? skillName(skill,locale) : skillCopy[locale].title) : agentPage ? (findAgentRole(path)?.name ?? agentDocsCopy[locale].title) : project ? project.name : path==='contribute' ? t.guide : path==='projects' ? t.work : path==='studio' ? e.aboutTitle : path==='privacy' ? t.privacy : t.eyebrow;
const description=skillPage ? (skill ? skillSummary(skill,locale) : skillCopy[locale].intro) : agentPage ? (findAgentRole(path) ? agentDocsCopy[locale].roles[findAgentRole(path)!.id].description : agentDocsCopy[locale].intro) : details?.description ?? (path==='contribute' ? t.contributeText : path==='projects' ? t.workIntro : path==='privacy' ? t.privacyText[0] : t.intro);
---
<Base locale={locale} path={path} title={title} description={description} image={project && project.id!=='boundra'?projectImage(project,locale).src:undefined} imageAlt={project?.id==='boundra'?undefined:details?.alt}>
{path==='' && <>
  <section class="hero opening-scene" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 id="hero-title">{t.headline.join(' ').trim()}</h1>
      <p class="lead">{t.intro}</p>
      <div class="actions"><a class="button primary om-button om-button--link om-button--primary om-button--md" href="#work">{t.explore} <span aria-hidden="true">↓</span></a><PlatformLinks name="Oddmash" github="https://github.com/Oddmash" /></div>
    </div>
    <div class="brand-art" aria-hidden="true">
      <div class="scene-light"></div>
      <img src="/assets/oddmash-logo.png" width="640" height="640" alt="" fetchpriority="high" />
    </div>
  </section>
  <section class="section projects-overview" id="work" aria-labelledby="work-title">
    <div class="section-title"><h2 id="work-title">{lab.projectTitle}</h2><p>{lab.projectLead}</p></div>
    <div class="projects project-gallery">{projects.map(project=><ProjectCard locale={locale} project={project} />)}</div>
    <a class="text-link catalog-cta" href={url(locale,'projects')}>{t.back}</a>
  </section>
  <LabStory locale={locale} />
  <section class="section contribute closing-cta" id="contribute"><div><h2>{t.contribute}</h2><p>{t.contributeText}</p></div><div class="actions"><a class="button primary om-button om-button--link om-button--primary om-button--md" href={url(locale,'contribute')}>{t.guide}</a><a class="button secondary om-button om-button--link om-button--secondary om-button--md" href={url(locale,'studio')}>{t.nav[1]}</a></div></section>
</>}
{path==='contribute' && <ContributionGuide locale={locale} />}
{skillPage && <SkillDocs locale={locale} path={path} />}
{agentPage && <AgentDocs locale={locale} path={path} />}
{path==='projects' && <>
  <section class="detail-head"><p class="eyebrow">Oddmash</p><h1>{t.work}</h1><p class="lead">{t.workIntro}</p></section>
  <section class="section catalog-projects" aria-label={t.work}>
    {projects.map(item=>{
      const detail=t.projects[item.id];
      const destinations=projectLinks(item.id,locale);
      return <article class="catalog-entry">
        <div class="catalog-identity"><p class="tag">{detail.type}</p><h2><a class="text-link project-destination" href={url(locale,'projects/'+item.id)} aria-label={item.name+' '+t.details}>{item.name}</a></h2><ProjectImage project={item} locale={locale} alt={detail.alt} lazy /></div>
        <div class="catalog-description"><p>{detail.description}</p><h3>{e.exampleHeading}</h3><p>{e.examples[item.id]}</p><PlatformLinks name={item.name} github={item.repo} npm={item.package} homepage={destinations.live} homepageLabel={homepageNames[locale]} docs={destinations.docs} docsLabel={t.docs} /></div>
      </article>;
    })}
  </section>
  <section class="section ecosystem-section" aria-labelledby="ecosystem-title">
    <div class="section-title"><h2 id="ecosystem-title">{ecosystem.title}</h2><p>{ecosystem.intro}</p></div>
    <div class="ecosystem-grid">
      <article><h3>Oddmash Skills</h3><p>{ecosystem.skills}</p><PlatformLinks name="Oddmash Skills" github="https://github.com/Oddmash/oddmash-skills" docs={url(locale,'skills')} docsLabel={t.docs} docsPrimary /></article>
      <article><h3>Oddmash Agents</h3><p>{ecosystem.agents}</p><PlatformLinks name="Oddmash Agents" github="https://github.com/Oddmash/oddmash-agents" docs={url(locale,'agents')} docsLabel={t.docs} docsPrimary /></article>
    </div>
  </section>
</>}
{project && details && links && <>
  <a class="text-link detail-back" href={url(locale,'projects')}>{t.back}</a>
  <section class="detail-head detail-hero" aria-labelledby="detail-title">
    <div class="detail-copy">
      <p class="eyebrow">{details.type}</p>
      <h1 id="detail-title">{project.name}</h1>
      <p class="detail-summary">{details.summary}</p>
      <p class="lead">{details.description}</p>
      <div class="actions">
        <PlatformLinks name={project.name} github={project.repo} npm={project.package} homepage={links.live} homepageLabel={homepageNames[locale]} docs={links.docs} docsLabel={t.docs} />
        {project.id === 'boundra' && <a class="text-link" href="https://marketplace.visualstudio.com/items?itemName=oddmash.boundra-vscode">
          {{ en: 'VS Code pre-release', ko: 'VS Code 사전 출시 버전', ja: 'VS Code プレリリース版', 'zh-CN': 'VS Code 预发行版' }[locale]}
        </a>}
      </div>
    </div>
    <figure class="detail-image"><a class="detail-image-link" href={links.live ?? links.readme} aria-label={project.name+' '+(links.live ? homepageNames[locale] : t.repository)}><ProjectImage locale={locale} project={project} alt={details.alt}/></a><figcaption>{details.alt}</figcaption></figure>
  </section>
  <ProjectStory locale={locale} projectId={project.id} />
  {project.id==='juliya' && <WrapDemo locale={locale} />}
  <section class="section related-projects"><div class="section-title"><h2>{t.back}</h2><a class="text-link" href={url(locale,'projects')}>{t.explore}</a></div><ul class="project-link-list">{projects.filter(p=>p.id!==project.id).map(p=>{const destinations=projectLinks(p.id,locale);return <li class="project-index-row"><a class="project-destination" href={url(locale,'projects/'+p.id)}>{p.name}</a><PlatformLinks name={p.name} github={p.repo} npm={p.package} homepage={destinations.live} homepageLabel={homepageNames[locale]} docs={destinations.docs} docsLabel={t.docs} /></li>;})}</ul></section>
</>}
{path==='studio' && <>
  <section class="about-hero detail-head"><p class="eyebrow">Oddmash</p><h1>{e.aboutTitle}</h1><p class="lead">{e.aboutLead}</p><div class="actions"><a class="button primary om-button om-button--link om-button--primary om-button--md" href={contributionUrl}>{e.contributeAction}</a><a class="button secondary om-button om-button--link om-button--secondary om-button--md" href={url(locale,'projects')}>{t.explore}</a></div></section>
  <section class="section about-principles" aria-labelledby="principles-title"><h2 id="principles-title">{t.studio}</h2><div class="principle-list">{t.principles.map(([heading,body])=><div><h3>{heading}</h3><p>{body}</p></div>)}</div><a class="text-link" href={home+'#method'}>{lab.methodNav}</a></section>
  <section class="section contribute"><div><h2>{e.contributeAction}</h2><p>{e.aboutContribution}</p></div><a class="button primary om-button om-button--link om-button--primary om-button--md" href={contributionUrl}>{e.contributeAction}</a></section>
</>}
{path==='privacy' && <article class="policy detail-head om-prose"><p class="eyebrow">Oddmash</p><h1>{t.privacy}</h1>{t.privacyText.map(p=><p>{p}</p>)}<a class="text-link" href="https://github.com/Oddmash">GitHub</a></article>}
</Base>
