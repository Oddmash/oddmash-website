---
import '../styles/site.scss';
import '../styles/language-select.scss';
import { copy, labels, locales, languageNames, url, type Locale } from '../content';
import { absolute, indexable } from '../site';
import { skillCopy } from '../skill-content';
import { agentDocsCopy } from '../agent-content';
interface Props { locale:Locale; path:string; title:string; description:string; image?:string; imageAlt?:string; noIndex?:boolean }
const {locale,path,title,description,image='/assets/social.png',imageAlt,noIndex=false} = Astro.props;
const t = copy[locale];
const l = labels[locale];
const home = url(locale);
const canonical = noIndex ? undefined : absolute(url(locale,path));
---
<!doctype html>
<html lang={locale} data-page={path === '' && !noIndex ? 'home' : undefined}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#101010" />
<meta name="color-scheme" content="dark" />
<title>{title} | Oddmash</title>
<meta name="description" content={description} />
<meta name="robots" content={indexable && !noIndex ? 'index, follow' : 'noindex, nofollow'} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title + ' | Oddmash'} />
<meta property="og:description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
{canonical && <meta property="og:url" content={canonical} />}
{canonical && <meta property="og:image" content={absolute(image)} />}
{canonical && <meta property="og:image:alt" content={imageAlt ?? l.socialAlt} />}
{canonical && <meta name="twitter:card" content="summary_large_image" />}
{canonical && locales.map(lang=><link rel="alternate" hreflang={lang} href={absolute(url(lang,path))} />)}
{canonical && <link rel="alternate" hreflang="x-default" href={absolute(url('en',path))} />}
<link rel="icon" href="/assets/oddmash-logo.png" />
</head>
<body>
<a class="skip" href="#main">{t.skip}</a>
<header class="shell header">
  <a class="brand" href={home} aria-label={l.home}><img src="/assets/oddmash-logo.png" width="38" height="38" alt="" /><span>oddmash<span class="brand-dot">.</span></span></a>
  <nav class="primary-navigation" aria-label={l.navigation}><a href={home} aria-current={path===''?'page':undefined}>{({en:'Home',ko:'홈',ja:'ホーム','zh-CN':'首页'})[locale]}</a><a href={url(locale,'projects')} aria-current={path==='projects'||path.startsWith('projects/')?'page':undefined}>{t.nav[0]}</a><a href={url(locale,'agents')} aria-current={path==='agents'||path.startsWith('agents/')?'page':undefined}>{agentDocsCopy[locale].nav}</a><a href={url(locale,'skills')} aria-current={path==='skills'||path.startsWith('skills/')?'page':undefined}>{skillCopy[locale].nav}</a><a href={url(locale,'contribute')} aria-current={path==='contribute'?'page':undefined}>{t.nav[2]}</a></nav>
  <div class="language-select" data-om-theme="dark" hidden></div>
  <nav class="language-fallback" aria-label={t.language}>{locales.map(lang=><a lang={lang} hreflang={lang} href={url(lang,path)} aria-current={lang===locale ? 'page' : undefined} data-locale={lang}>{languageNames[lang]}</a>)}</nav>
</header>
<main id="main" class="shell" tabindex="-1"><slot /></main>
<footer class="shell footer">
  <a class="brand" href={home} aria-label={l.home}><img src="/assets/oddmash-logo.png" width="30" height="30" alt="" /><span>oddmash.</span></a>
  <p>© {new Date().getFullYear()} Oddmash</p>
  <nav aria-label={l.footer}><a href={url(locale,'privacy')} aria-current={path==='privacy'?'page':undefined}>{t.privacy}</a><a href="https://github.com/Oddmash">GitHub</a>{!noIndex && <button id="share" hidden type="button" data-success={t.copied} data-failure={t.copyFailed}>{t.share}</button>}</nav>

  <input id="share-fallback" type="url" readonly hidden aria-label={l.shareLink} />
</footer>
<div id="copy-toast" data-om-theme="dark"></div>
<script>
import { notifyCopy } from '../copy-toast';
import { SelectDropdown } from '@oddmash/ui/select';
import { createElement } from 'react';
import { createRoot } from 'react-dom/client';
import { flushSync } from 'react-dom';

const picker = document.querySelector<HTMLElement>('.language-select');
const fallbackLinks = document.querySelector<HTMLElement>('.language-fallback');
if(picker && fallbackLinks) {
  const links = [...fallbackLinks.querySelectorAll<HTMLAnchorElement>('a[data-locale]')];
  const options = links.map(link => ({
    value: link.dataset.locale ?? '',
    label: link.textContent?.trim() ?? '',
  }));
  const selectLanguage = (value: string) => {
    const link = links.find(anchor => anchor.dataset.locale === value);
    if(!link) return;
    const destination = new URL(link.href);
    destination.hash = location.hash;
    location.assign(destination.href);
  };
  try {
    const root = createRoot(picker);
    flushSync(() => {
      root.render(createElement(SelectDropdown, {
        id: 'language-select',
        'aria-label': fallbackLinks.getAttribute('aria-label') ?? 'Language',
        options,
        value: document.documentElement.lang,
        onValueChange: selectLanguage,
      }));
    });
    if(picker.querySelector('#language-select')) {
      picker.hidden = false;
      fallbackLinks.hidden = true;
    }
  } catch {
    picker.hidden = true;
    fallbackLinks.hidden = false;
  }
}
const share = document.querySelector<HTMLButtonElement>('#share');
const fallback = document.querySelector<HTMLInputElement>('#share-fallback');
if (share) {
  share.hidden = false;
  share.addEventListener('click', async () => {
    const link = new URL(location.pathname, location.origin).href;
    try {
      await navigator.clipboard.writeText(link);
      if (fallback) fallback.hidden = true;
      notifyCopy(share.dataset.success ?? '');
    } catch {
      if (fallback) { fallback.value = link; fallback.hidden = false; }
      notifyCopy(share.dataset.failure ?? '', true);
    }
  });
}
</script>
<style is:global>
  html[lang="en"] main,
  html[lang="ja"] main,
  html[lang="zh-CN"] main {
    word-break: normal;
    overflow-wrap: anywhere;
  }
  html[lang="ja"] main,
  html[lang="zh-CN"] main {
    line-break: strict;
  }
</style>
<script>
import { mountKowrap } from '@oddmash/kowrap/browser';

const root = document.querySelector<HTMLElement>('main');
const eligible = 'h1, h2, h3, h4, h5, h6, p, li, figcaption, dt, dd, blockquote';
const inlineTags = new Set([
  'A', 'ABBR', 'B', 'BDI', 'BDO', 'BR', 'CITE', 'CODE', 'DEL', 'EM', 'I',
  'INS', 'KBD', 'MARK', 'Q', 'S', 'SAMP', 'SMALL', 'SPAN', 'STRONG',
  'SUB', 'SUP', 'TIME', 'U', 'VAR', 'WBR',
]);
const excluded = '.demo-pair, [hidden], [aria-hidden="true"], [role="status"], [aria-live]:not([aria-live="off"]), [contenteditable], [data-no-wrap], .sr';
const controllers = new Map<HTMLElement, ReturnType<typeof mountKowrap>>();
let observer: MutationObserver | undefined;
let frame: number | undefined;

const isEligible = (element: HTMLElement) => {
  const language = element.closest('[lang]')?.getAttribute('lang')?.toLowerCase();
  if (language !== 'ko' || element.closest(excluded)) return false;
  if (!/[가-힣]/.test(element.textContent ?? '')) return false;
  return [...element.querySelectorAll<HTMLElement>('*')].every(child =>
    inlineTags.has(child.tagName) &&
    !child.matches(excluded) &&
    (!child.hasAttribute('lang') || child.lang.toLowerCase() === 'ko') &&
    (child.tagName === 'BR' || child.tagName === 'WBR' || getComputedStyle(child).display === 'inline')
  );
};

const unmount = (element: HTMLElement, controller: ReturnType<typeof mountKowrap>) => {
  controller.destroy();
  element.removeAttribute('data-kowrap-applied');
  controllers.delete(element);
};

const sync = () => {
  if (!root) return;
  for (const [element, controller] of controllers) {
    if (!element.isConnected || element.closest(excluded)) unmount(element, controller);
  }
  for (const element of root.querySelectorAll<HTMLElement>(eligible)) {
    if (controllers.has(element) || !isEligible(element)) continue;
    const original = {
      whiteSpace: element.style.whiteSpace,
      wordBreak: element.style.wordBreak,
      overflowWrap: element.style.overflowWrap,
    };
    try {
      const controller = mountKowrap(element, {
        inline: true,
        breakLongWords: false,
      });
      controllers.set(element, controller);
      element.style.overflowWrap = 'anywhere';
      element.dataset.kowrapApplied = 'true';
    } catch {
      Object.assign(element.style, original);
      element.removeAttribute('data-kowrap-applied');
    }
  }
};

const queueSync = () => {
  if (frame !== undefined) return;
  frame = requestAnimationFrame(() => {
    frame = undefined;
    sync();
  });
};

const start = () => {
  if (!root || observer) return;
  sync();
  observer = new MutationObserver(queueSync);
  observer.observe(root, {
    attributes: true,
    attributeFilter: ['hidden', 'aria-hidden'],
    subtree: true,
  });
};

const stop = () => {
  observer?.disconnect();
  observer = undefined;
  if (frame !== undefined) cancelAnimationFrame(frame);
  frame = undefined;
  for (const [element, controller] of controllers) unmount(element, controller);
};

window.addEventListener('pagehide', stop);
window.addEventListener('pageshow', event => { if (event.persisted) start(); });
start();
</script>

</body>
</html>
